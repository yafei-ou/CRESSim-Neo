import os
from pathlib import Path

_PACKAGE_DIR = Path(__file__).resolve().parent
# Diligent loads the Vulkan DXC runtime by its bare name
# (spv_dxcompiler.dll). Windows does not search a Python package directory
# for that call, so retain this handle for the lifetime of the package.
_PACKAGE_DLL_DIRECTORIES: list[object] = []
if os.name == "nt" and hasattr(os, "add_dll_directory"):
    _PACKAGE_DLL_DIRECTORIES.append(os.add_dll_directory(str(_PACKAGE_DIR)))

from ._cuda_runtime import ensure_cuda_runtime as _ensure_cuda_runtime
from ._cuda_runtime import get_cuda_runtime_diagnostics

_ensure_cuda_runtime()

from ._cressim_neo import *  # noqa: F401,F403

try:
    from .cartpole import CartpoleGymnasiumAdapter, CartpoleTorchVectorEnv
except RuntimeError:
    CartpoleGymnasiumAdapter = None
    CartpoleTorchVectorEnv = None

try:
    from .soft_body_pusher_env import SoftBodyPusherTorchVectorEnv
except RuntimeError:
    SoftBodyPusherTorchVectorEnv = None

try:
    from .fluid_pouring_env import FluidPouringTorchVectorEnv
except RuntimeError:
    FluidPouringTorchVectorEnv = None

try:
    from .camera_centering_env import CameraCenteringTorchVectorEnv
except RuntimeError:
    CameraCenteringTorchVectorEnv = None

try:
    from .ultrasound_centering_env import UltrasoundCenteringTorchVectorEnv
except RuntimeError:
    UltrasoundCenteringTorchVectorEnv = None

try:
    from .soft_body_env import SoftBodyTorchVectorEnv
except RuntimeError:
    SoftBodyTorchVectorEnv = None

try:
    from .fluid_env import FluidTorchVectorEnv
except RuntimeError:
    FluidTorchVectorEnv = None

try:
    from .psm_soft_grasp_env import PsmSoftGraspTorchVectorEnv
except RuntimeError:
    PsmSoftGraspTorchVectorEnv = None

try:
    from .psm_blood_suction_env import PsmBloodSuctionTorchVectorEnv
except RuntimeError:
    PsmBloodSuctionTorchVectorEnv = None

from .psm_builder import (
    PsmAuthoringConfig,
    PsmBuildResult,
    PsmRobotInstance,
    author_psm_scene,
    get_psm_default_runtime_config,
    set_psm_joint_targets,
)
from .psm_env import PsmEnv


_PACKAGE_ASSET_DIR = _PACKAGE_DIR / "assets"
_ASSET_DIR = Path(os.environ.get("CRESSIM_NEO_ASSET_DIR", _PACKAGE_ASSET_DIR)).expanduser()
_SHADERS_DIR = _ASSET_DIR / "shaders"
_runtime_initialize = Runtime.initialize


def _initialize_with_package_defaults(self, config=None):
    if config is None:
        config = RuntimeConfig()
    if not config.gpu_device_desc.shader_directory:
        config.gpu_device_desc.shader_directory = str(_SHADERS_DIR)
    return _runtime_initialize(self, config)


Runtime.initialize = _initialize_with_package_defaults

__all__ = [
    name
    for name in globals()
    if not name.startswith("_") and globals()[name] is not None
]
