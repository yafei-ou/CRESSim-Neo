<?xml version="1.0" encoding="utf-8"?>
<!-- Reduced-chain PSM model with locally modified meshes for CRESSim-Neo. -->
<robot name="psm_suction_irrigator">
    <material name="white">
        <color rgba="0.95 0.95 0.95 1"/>
    </material>
    <material name="yellow">
        <color rgba="0.9843 0.8863 0.3176 1"/>
    </material>
    <material name="orange">
        <color rgba="1.00 0.77 0.03 1"/>
    </material>
    <material name="grey">
        <color rgba="0.80 0.80 0.80 1"/>
    </material>
    <material name="silver">
        <color rgba="0.8941 0.8941 0.8863 1"/>
    </material>
    <material name="black">
        <color rgba="0.0314 0.0314 0.0314 1"/>
    </material>
    <material name="red_translucent">
        <color rgba="1 0 0 0.5"/>
    </material>

    <link name="psm_base_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0 -0.17016 -0.085607"/>
            <mass value="2.0161"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/base_link.STL"/>
            </geometry>
            <material name="white"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/base_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <link name="psm_yaw_link">
        <inertial>
            <!-- by jqxu 0.041596+0.4864-->
            <origin rpy="0 0 0" xyz="-0.038769 0 0.527996"/>
            <mass value="1.4705"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <!-- by jqxu: 0.4864 -->
            <origin rpy="0 0 0" xyz="0 0 0.4864"/>
            <geometry>
                <mesh filename="meshes/visual/yaw_link.STL"/>
            </geometry>
            <material name="white"/>
        </visual>
        <!--    <collision>-->
        <!--      &lt;!&ndash; by jqxu: 0.4864 &ndash;&gt;-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0.4864"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/yaw_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_yaw_joint" type="revolute">
        <!-- by jqxu: 0.4864 -->
        <origin rpy="1.57079632679 -1.57079632679 0" xyz="0 0.4864 0"/>
        <parent link="psm_base_link"/>
        <child link="psm_yaw_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-1.5883" upper="1.5883" velocity="2.1"/>
    </joint>

    <link name="psm_pitch_end_link">
        <inertial>
            <!-- by jqxu: rpy="0 0 3.14159265359" -->
            <!-- by jqxu: xyz="-(-0.0019293)+0.0423 -(-0.13613)+0.14372 0" -->
            <origin rpy="0 0 0" xyz="0.0442293 0.27985 0"/>
            <mass value="2.091"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <!-- by jqxu: rpy="0 0 3.14159265359" -->
            <!-- by jqxu: xyz="0.0423 0.14372 0" -->
            <origin rpy="0 0 3.14159265359" xyz="0.0423 0.14372 0"/>
            <geometry>
                <mesh filename="meshes/visual/pitch_end_link.STL"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!--    <collision>-->
        <!--      &lt;!&ndash; by jqxu: rpy="0 0 3.14159265359 &ndash;&gt;-->
        <!--      &lt;!&ndash; by jqxu: xyz="0.0423 0.14372 0" &ndash;&gt;-->
        <!--      <origin rpy="0 0 3.14159265359" xyz="0.0423 0.14372 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/pitch_end_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_pitch_end_joint" type="revolute">
        <!-- by jqxu: rpy="-1.57079632679 -1.57079632679 0" -->
        <origin rpy="-1.57079632679 -1.57079632679 0" xyz="0 0 0"/>
        <parent link="psm_yaw_link"/>
        <child link="psm_pitch_end_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-0.9251" upper="0.9251" velocity="2.1"/>
    </joint>

    <link name="psm_main_insertion_link">
        <inertial>
            <!-- by jqxu: <origin rpy="0 0 0" xyz="0.0040563 -0.00010934 0.0098616"/> -->
            <origin rpy="0 0 0" xyz="-0.00010934 -0.0040563 0.0098616"/>
            <mass value="0.22491"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <!-- by jqxu: rpy="0 0 0" -->
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/main_insertion_link_1_2_suction_irrigator_combined.obj"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/main_insertion_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_main_insertion_joint" type="prismatic">
        <!-- by jqxu: rpy="1.57079632679 0 0" -->
        <!-- by jqxu: xyz="0 0.4318 0" -->
        <origin rpy="1.57079632679 0 0" xyz="0 0.4318 0"/>
        <parent link="psm_pitch_end_link"/>
        <child link="psm_main_insertion_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="0" upper="0.24" velocity="1"/>
    </joint>

    <link name="psm_tool_pitch_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.0035763 0 0"/>
            <mass value="0.00025784"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/tool_suction_irrigator_pitch.obj"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/tool_suction_irrigator_pitch.obj"/>
            </geometry>
        </collision>
    </link>

    <joint name="psm_tool_pitch_joint" type="revolute">
        <!-- by jqxu: <origin rpy="-1.57079632679 -1.57079632679 3.14159265359" xyz="0 0 0"/> -->
        <!-- by jqxu: rpy="-1.57079632679 -1.57079632679 0" -->
        <origin rpy="-1.57079632679 -1.57079632679 0" xyz="0 0 0.447"/>
        <parent link="psm_main_insertion_link"/>
        <child link="psm_tool_pitch_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-1.3963" upper="1.3963" velocity="2.1"/>
    </joint>

    <link name="psm_tool_yaw_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <!-- mass is important for physics simulation -->
            <mass value="0.1"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/tool_suction_irrigator_yaw.obj"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/tool_suction_irrigator_yaw.obj"/>
            </geometry>
        </collision>
    </link>

    <joint name="psm_tool_yaw_joint" type="revolute">
        <!-- by jqxu: <origin rpy="1.57079632679 -1.57079632679 3.14159265359" xyz="0.0091 0 0"/> -->
        <origin rpy="-1.57079632679 -1.57079632679 0" xyz="0.006 0 0"/>
        <parent link="psm_tool_pitch_link"/>
        <child link="psm_tool_yaw_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-1.3963" upper="1.3963" velocity="2.1"/>
    </joint>

    <!-- by jqxu -->
    <link name="psm_tool_tip_link">
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <!--    <visual>-->
        <!--      <geometry>-->
        <!--        <sphere radius="0.002"/>-->
        <!--      </geometry>-->
        <!--      <material name="red_translucent"/>-->
        <!--    </visual>-->
    </link>

    <joint name="psm_tool_tip_joint" type="fixed">
        <parent link="psm_tool_yaw_link"/>
        <child link="psm_tool_tip_link"/>
        <origin rpy="-1.57079632679 -1.57079632679 0" xyz="0 0.0102 0"/>
    </joint>

    <link name="psm_pitch_back_link">
        <inertial>
            <origin rpy="0 0 0" xyz="-0.011651 -0.036241 0"/>
            <mass value="0.98494"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/pitch_back_link.STL"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/pitch_back_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_pitch_back_joint" type="revolute">
        <!-- by jqxu: 0.0296+0.4864 -->
        <!-- by jqxu: -0.29073 -->
        <origin rpy="-1.57079632679 -0.29038632563 0" xyz="0 0 0.516"/>
        <parent link="psm_yaw_link"/>
        <child link="psm_pitch_back_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-0.93556" upper="0.94249" velocity="10"/>
    </joint>

    <link name="psm_pitch_bottom_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.25683 -0.010348 0"/>
            <mass value="0.44569"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/pitch_bottom_link.STL"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/pitch_bottom_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_pitch_bottom_joint" type="revolute">
        <origin rpy="0 0 1.86118265242" xyz="0.15 0 0"/>
        <parent link="psm_pitch_back_link"/>
        <child link="psm_pitch_bottom_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-0.94249" upper="0.93556" velocity="10"/>
        <mimic joint="psm_pitch_back_joint" multiplier="-1"/>
    </joint>

    <link name="psm_pitch_top_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.31246 -0.00056566 0"/>
            <mass value="0.17841"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/pitch_top_link.STL"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/pitch_top_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_pitch_top_joint" type="revolute">
        <origin rpy="0 0 1.86118265242" xyz="0.18366 0.014121 0"/>
        <parent link="psm_pitch_back_link"/>
        <child link="psm_pitch_top_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" lower="-0.94249" upper="0.93556" velocity="10"/>
        <mimic joint="psm_pitch_back_joint" multiplier="-1"/>
    </joint>

    <link name="psm_pitch_front_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0.096269 0 0.047551"/>
            <mass value="0.074425"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="meshes/visual/pitch_front_link.STL"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!--    <collision>-->
        <!--      <origin rpy="0 0 0" xyz="0 0 0"/>-->
        <!--      <geometry>-->
        <!--        <mesh filename="meshes/collision/pitch_front_link.STL"/>-->
        <!--      </geometry>-->
        <!--    </collision>-->
    </link>

    <joint name="psm_pitch_front_joint" type="revolute">
        <!-- by jqxu: -0.0664+0.4864 -->
        <origin rpy="-1.57079632679 -0.29038632563 0" xyz="0 0 0.42"/>
        <parent link="psm_yaw_link"/>
        <child link="psm_pitch_front_link"/>
        <axis xyz="0 0 1"/>
        <mimic joint="psm_pitch_back_joint" multiplier="1"/>
        <limit effort="100" lower="-0.93556" upper="0.94249" velocity="10"/>
    </joint>

    <link name="psm_remote_center_link">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="0.015"/>
            </geometry>
            <material name="red_translucent"/>
        </visual>
    </link>

    <joint name="psm_remote_center_joint" type="fixed">
        <parent link="psm_base_link"/>
        <child link="psm_remote_center_link"/>
        <origin rpy="0 0 0" xyz="0 0.4864 0"/>
    </joint>
</robot>
