# Maintained source recipe for Arch Linux. Publish it to the AUR separately.
pkgname=python-cressim-neo
pkgver=0.1.0
pkgrel=1
pkgdesc='GPU-accelerated surgical simulation engine with Python bindings'
arch=('x86_64')
url='https://github.com/yafei-ou/CRESSim-Neo'
license=('MIT')
depends=('python' 'python-numpy' 'python-pytorch' 'cuda' 'vulkan-icd-loader')
makedepends=('clang' 'cmake' 'git' 'ninja' 'python-pybind11')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "CRESSim-Neo-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCRESSIM_NEO_BUILD_PYTHON=ON \
        -DCRESSIM_NEO_BUILD_VIEWER=OFF \
        -DCRESSIM_NEO_BUILD_EXAMPLES=OFF \
        -DCRESSIM_NEO_ENABLE_CUDA_INTEROP=ON \
        -DCRESSIM_NEO_ENABLE_ULTRASOUND=ON \
        -DCRESSIM_NEO_CUDA_RUNTIME_PROVIDER=SYSTEM \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build --component Python
}
