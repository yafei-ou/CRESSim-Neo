PROJECT_NAME           = "CRESSim-Neo"

OUTPUT_DIRECTORY       = "@CRESSIM_NEO_DOCS_DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO

OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CRESSIM_NEO_REPOSITORY_DIR@"
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
MAX_INITIALIZER_LINES  = 1

INPUT                  = "@CRESSIM_NEO_REPOSITORY_DIR@/include"
FILE_PATTERNS          = *.h \
                         *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = CRESSIM_NEO_COMMON_API= \
                         CRESSIM_NEO_ENGINE_API= \
                         CRESSIM_NEO_GPU_API= \
                         CRESSIM_NEO_GRAPHICS_API= \
                         CRESSIM_NEO_PHYSICS_API= \
                         CRESSIM_NEO_VIEWER_API=

HAVE_DOT               = NO
